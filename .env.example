# Production .env template (ADR-026 §4). Copy to /opt/masyarakat/.env on the Droplet, mode 600. Never commit it.
DOMAIN=app.example.my
# URL-safe only (used inside DATABASE_URL). Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
# At least 32 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
# DigitalOcean Spaces, Singapore (ADR-014 amendment, ADR-025 §1)
S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
S3_REGION=sgp1
S3_BUCKET=masyarakat-private
S3_PUBLIC_BUCKET=masyarakat-public
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The public Space's CDN endpoint, e.g. https://masyarakat-public.sgp1.cdn.digitaloceanspaces.com
S3_PUBLIC_BASE_URL=
# ADR-031 §6: where per-organisation archive keys live (the erasure-keys volume in docker-compose.prod.yml).
# The API refuses to start in production without it. Keep it out of database dumps.
ERASURE_KEY_DIR=/var/lib/masyarakat/erasure-keys
