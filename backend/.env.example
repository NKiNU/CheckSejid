PORT=3000
DATABASE_URL="postgresql://masyarakat:masyarakat@localhost:5432/masyarakat?schema=public"
# Access-token signing secret, at least 32 chars. Never commit a real one.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Set only when behind a reverse proxy: hop count (e.g. 1) or IPs/CIDRs (e.g. loopback, 10.0.0.0/8).
# Leave empty to ignore X-Forwarded-For (otherwise clients could spoof their IP to evade rate limits).
TRUST_PROXY=
# Object storage (ADR-014/020): S3 API. Dev uses MinIO from docker-compose; leave S3_ENDPOINT empty on AWS.
# The public/ prefix must be publicly readable (logo/cover); everything else stays private.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-5
S3_BUCKET=masyarakat
S3_ACCESS_KEY_ID=masyarakat
S3_SECRET_ACCESS_KEY=masyarakat-dev-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/masyarakat
