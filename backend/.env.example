PORT=3000
DATABASE_URL="postgresql://masyarakat:masyarakat@localhost:5432/masyarakat?schema=public"
# Access-token signing secret, at least 32 chars. Never commit a real one.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Set only when behind a reverse proxy: hop count (e.g. 1) or IPs/CIDRs (e.g. loopback, 10.0.0.0/8).
# Leave empty to ignore X-Forwarded-For (otherwise clients could spoof their IP to evade rate limits).
TRUST_PROXY=
# Object storage (ADR-014/020/025): S3 API. Dev uses SeaweedFS from docker-compose (one bucket is fine in dev).
# Production uses two DigitalOcean Spaces: see the root .env.example and docs/operations/RUNBOOK.md.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=masyarakat
S3_ACCESS_KEY_ID=masyarakat
S3_SECRET_ACCESS_KEY=masyarakat-dev-secret
S3_PUBLIC_BASE_URL=http://localhost:9000/masyarakat

# ADR-031 §6: directory (outside the database and its backups) holding per-organisation archive keys, mode 0600.
ERASURE_KEY_DIR=./.erasure-keys
# Erasure transaction timeout in ms (ADR-031 §5); default 120000.
# ERASURE_TX_TIMEOUT_MS=120000
