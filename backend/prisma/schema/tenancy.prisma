// Phase 02 — Organisation tenancy.
// Organisation is the tenant root (TENANT-001): it is keyed by its own id rather than
// carrying an organisationId. OrganisationMembership is tenant-owned (TENANT-002/008).

// Phase 04 (ADR-016): lifecycle states and profile.
enum OrganisationStatus {
  DRAFT
  ONBOARDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// ORG-007: generic organisation types, not Masjid-only.
enum OrganisationType {
  masjid
  surau
  madrasah
  school
  ngo
  other
}

model Organisation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  // ORG-002 / ADR-006: a management user actively manages one organisation; the unique
  // constraint enforces "one owned organisation per user" in the database.
  // Phase 03 (ADR-015): this column IS the `owner` role. Owner is never stored as a
  // MembershipRole row (the Role enum has no owner value), so "exactly one owner" (RBAC-008)
  // holds by construction and changes only through ownership transfer. A deferred constraint
  // trigger (rbac migration) guarantees the owner is always a member of the organisation.
  ownerId   String   @unique @db.Uuid
  owner     User     @relation("OrganisationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ORG-008/009. Changed only by tenancy.service transition(); read by the lifecycle guard.
  status       OrganisationStatus @default(DRAFT)
  type         OrganisationType?
  description  String?
  contactEmail String?
  contactPhone String?
  addressLine  String?
  state        String?
  country      String? // ISO 3166-1 alpha-2
  links        Json? // [{ label, url }], http(s) only, validated at the API

  memberships OrganisationMembership[]
  auditLogs   AuditLog[]
}

// Store membership only (ORG-003). Roles are MembershipRole rows (rbac.prisma).
model OrganisationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ADR-015 §2: free-text display title (e.g. "Nazir", "Imam"). Grants nothing.
  title          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  roles MembershipRole[]

  @@unique([organisationId, userId])
  @@unique([id, organisationId]) // target of MembershipRole's tenant-consistent composite FK
  @@index([userId])
}
