// Phase 13A (ADR-029, ADR-031) — data retention and erasure.
// None of these models has a foreign key to the subject: a request must outlive the data it erases,
// and carries no deleted content (PDPA-003). ErasureRequest uses subjectId, not organisationId, so
// it is not a tenant table and survives the erasure it records.

enum ErasureKind {
  USER
  ORGANISATION
}

enum ErasureStatus {
  PENDING_GRACE
  CANCELLED
  RUNNING
  COMPLETED
  FAILED
}

model ErasureRequest {
  id           String        @id @default(uuid()) @db.Uuid
  kind              ErasureKind
  subjectId         String        @db.Uuid // user id or organisation id, by kind
  requestedByUserId String        @db.Uuid
  status            ErasureStatus @default(PENDING_GRACE)
  executeAfter      DateTime // requestedAt + 7 days (ADR-031 §2)
  failureCode       String? // a code only, never row content
  createdAt         DateTime      @default(now())
  finishedAt        DateTime?

  @@index([status, executeAfter])
  @@index([kind, subjectId])
}

// ADR-031 §6: retention is opt-in. No row = immediate erasure, nothing kept.
model RetentionSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @unique @db.Uuid
  years          Int // 1, 3, 5 or 7; validated at the API and by a CHECK in the Phase 13 migration
  updatedAt      DateTime @updatedAt
}

// Survives the organisation it archives (no FK). The key is not here: it lives outside the database.
model ArchiveRecord {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @db.Uuid
  storageKey     String
  destroyAfter   DateTime
  destroyedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([destroyAfter])
}
